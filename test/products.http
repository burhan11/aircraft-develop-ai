        "currency_ID": "EUR",
        "receiptText": "Receipt Text",
        "supplierProductName": "Test Product Name",
        "productText": "Common Text"
}  

###Get Article
GET http://localhost:4004/odata/v4/product/Articles/d4f5b036-736a-4330-91d0-dada497b9609

