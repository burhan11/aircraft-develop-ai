                "brand_ID": "33a2212c-a27b-411a-8d88-c9ddb3105a0b"
        }
}

###Get Products
GET http://localhost:4004/odata/v4/product/ProductsToWritingAppointments?$expand=deliveryDate

###Get Products
PUT http://localhost:4004/odata/v4/product/ProductsToWritingAppointments(product_ID='00000000-0000-0000-0000-000000000001',writingAppointment_ID='4f2b6c1d-967d-4295-bbdf-b0a3e1ea1f77')
Content-Type: application/json

{
        "deliveryDates": [{"date": "2026-05-05"},{"date": "2025-05-05"}]
}

### Get Image URL
GET http://localhost:4004/odata/v4/product/Products/00000000-0000-0000-0000-000000000001/getImageUrl()

###Mark for Deletion - Article
POST http://localhost:4004/odata/v4/product/Articles/d4f5b036-736a-4330-91d0-dada497b9609/markForDeletion
Content-Type: application/json