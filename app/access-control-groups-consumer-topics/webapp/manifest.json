{
  "_version": "1.59.0",
  "sap.app": {
    "id": "com.valantic.preorder.accesscontrolgroupsconsumertopics",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.14.0",
      "toolsId": "563c126b-a9dd-468b-912a-a322ac045050"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/access-control-data/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ACGroupsConsumerTopics": {
          "semanticObject": "ACGroupsConsumerTopics",
          "action": "display",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "accesscontrolgroupsconsumertopics.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "GroupsConsumerTopicsList",
          "target": "GroupsConsumerTopicsList"
        },
        {
          "pattern": "GroupsConsumerTopics({key}):?query:",
          "name": "GroupsConsumerTopicsObjectPage",
          "target": "GroupsConsumerTopicsObjectPage"
        }
      ],
      "targets": {
        "GroupsConsumerTopicsList": {
          "type": "Component",
          "id": "GroupsConsumerTopicsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/GroupsConsumerTopics",
              "variantManagement": "Page",
              "navigation": {
                "GroupsConsumerTopics": {
                  "detail": {
                    "route": "GroupsConsumerTopicsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "liveMode": true
            }
          }
        },
        "GroupsConsumerTopicsObjectPage": {
          "type": "Component",
          "id": "GroupsConsumerTopicsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/GroupsConsumerTopics"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "public": true,
    "service": "com.valantic.preorder"
  }
}
