<mvc:View xmlns:smarttable="sap.ui.comp.smarttable" xmlns:filterbar="sap.ui.comp.filterbar"
    xmlns:f="sap.f"
    controllerName="com.valantic.preorder.planning.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartfilterbar="sap.ui.comp.smartfilterbar"
    xmlns="sap.m">
    <f:DynamicPage>
        <f:header>
            <f:DynamicPageHeader>
                <smartfilterbar:SmartFilterBar
                    id="smartFilterBar"
                    entitySet="Planning"
                    persistencyKey="SmartFilter_Planning"
                    enableBasicSearch="false"
                    liveMode="true"
                >
                    <smartfilterbar:layoutData>
                        <FlexItemData shrinkFactor="0" />
                    </smartfilterbar:layoutData>
                </smartfilterbar:SmartFilterBar>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smarttable:SmartTable
                id="smartTable"
                entitySet="Planning"
                tableType="ResponsiveTable"
                header="{i18n>planningTableHeader}"
                enableAutoBinding="true" class="sapUiResponsiveContentPadding"
                initiallyVisibleFields=""
                useVariantManagement="true"
                useTablePersonalisation="true"
                persistencyKey="SmartTable_Planning"
                requestAtLeastFields="ID"
                showRowCount="true"
                smartFilterId="smartFilterBar"
                enableCopy="false"
            >
                <smarttable:customToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer></ToolbarSpacer>
                        <Button icon="sap-icon://add" text="{i18n>common.create}"
                            press="onNewBtnPress" type="Emphasized" />
                        <Button
                        id="deleteOrderButton"
                        text="{i18n>archive}"
                        type="Transparent"
                        press=".onDeleteSelectedOrders"
                        enabled="false"
                    />
                        <!--<Button icon="sap-icon://sales-order" text="{i18n>releaseOrder}"
                            id="releaseOrderButton" press="onReleaseOrderPress"
                            enabled="false"></Button>-->
                    </OverflowToolbar>
                </smarttable:customToolbar>
                <Table mode="MultiSelect" selectionChange="onPlanningItemSelect">
                    <items>
                        <ColumnListItem type="Navigation" press="onPlanningItemPress"></ColumnListItem>
                    </items>
                </Table>
            </smarttable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>