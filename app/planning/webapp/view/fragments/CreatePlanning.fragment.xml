<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield">

    <Dialog id="createPlanningDialog" title="{i18n>planning.new.title}" contentWidth="4rem"
    >
        <content>
            <smartForm:SmartForm id="smartFormNewPlanningData"
                editTogglable="false"
                validationMode="Async"
                editable="true">
                <smartForm:layout>
                    <smartForm:ColumnLayout columnsM="2" columnsL="3" columnsXL="4" />
                </smartForm:layout>
                <smartForm:Group>
                    <smartForm:GroupElement label="{i18n>planning.new.supplier}">
                        <smartField:SmartField textInEditModeSource="ValueList" mandatory="true" value="{supplier_ID}"
                            importance="High" />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement label="{i18n>planning.new.consumerTopic}">
                        <smartField:SmartField textInEditModeSource="ValueList" mandatory="true"
                            value="{consumerTopic_ID}"
                            importance="High" />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement label="{i18n>planning.new.brand}">
                        <smartField:SmartField textInEditModeSource="ValueList" mandatory="true" value="{brand_ID}"
                            importance="High" />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement
                        label="{i18n>planning.new.name}">
                        <smartField:SmartField textInEditModeSource="ValueList" mandatory="true"
                            value="{name}"
                            importance="High" />
                    </smartForm:GroupElement>
                     <smartForm:GroupElement
                        label="{i18n>planning.new.orderDate}">
                        <smartField:SmartField textInEditModeSource="ValueList"
                            value="{date}"
                            importance="High" />
                    </smartForm:GroupElement>
                    <!--<smartForm:GroupElement
                        label="{i18n>planning.new.presentationType}">
                        <smartField:SmartField textInEditModeSource="ValueList"
                            value="{presentationType_code}"
                            importance="High" />
                    </smartForm:GroupElement> -->
                </smartForm:Group>
            </smartForm:SmartForm>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer></ToolbarSpacer>
                <Button text="{i18n>common.create}" press="newPlanningParamsAccept"></Button>
                <Button text="{i18n>common.cancel}" press="onCreatePlanningDialogClose"></Button>
            </OverflowToolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>