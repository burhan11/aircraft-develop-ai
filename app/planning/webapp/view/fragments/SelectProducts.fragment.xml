<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:uxap="sap.uxap"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:f="sap.f"
>

<m:Dialog title="{i18n>planning.selectProducts}" contentWidth="80%" contentHeight="80%" resizable="true" draggable="true">
    <m:content>
        <m:VBox class="sapUiMediumMargin">
            <smartFilterBar:SmartFilterBar id="productsSmartFilterBar" entitySet="Products"
                persistencyKey="ProductsFilterKey"
                    useToolbar="true"
                    showFilterConfiguration="true"                    showRestoreButton="true"
                    search=".onSmartFilterBarSearch"
                    filterChange=".onSmartFilterBarFilterChange"
                    class="sapUiMediumMarginBottom"
                enableBasicSearch="false" 
                liveMode="true">
                <smartFilterBar:layoutData>
                    <m:FlexItemData shrinkFactor="0" />
                </smartFilterBar:layoutData>
            </smartFilterBar:SmartFilterBar>
            
            <smartTable:SmartTable entitySet="Products" id="productsSmartTable"
                smartFilterId="productsSmartFilterBar" enableExport="false" beforeExport="onBeforeExport"
                useVariantManagement="true" useTablePersonalisation="true"
                header="{i18n>product.header}"
                showRowCount="true" persistencyKey="SmartTableRefApp_Explored"
                requestAtLeastFields="ID,imageUrl,isUploaded"
                enableAutoBinding="true" class="sapUiResponsiveContentPadding"
                showFullScreenButton="false"
                initiallyVisibleFields="ID,"
                tableType="Table"
                editable="false"
                enableAutoColumnWidth="true"
                enableCopy="false"
                app:preserveDecimals="false"
                     
                >
                <!-- layout data used to make the table growing -->
                <smartTable:layoutData>
                    <m:FlexItemData growFactor="1" baseSize="0%" />
                </smartTable:layoutData>

                <smartTable:customData>
                    <core:CustomData key="p13nDialogSettings"
                        value="{'columns':{'visible':true}}" />
                </smartTable:customData>
                <!-- Add the inner table with custom columns -->
                <t:Table>       
                    <t:columns>
                        <t:Column id="imageUrlProduct" autoResizable="true" resizable="true" hAlign="Center" minWidth="80px" >
                            <t:customData>
                                <core:CustomData key="p13nData"
                                    value="{'columnKey': 'imageUrl','columnIndex':'0'}" />
                            </t:customData>
                            <t:label>
                                <m:Label text="{i18n>planning.imageUrl}" />
                            </t:label>
                            <t:template >
                                <m:VBox justifyContent="Center" alignItems="Center" width="100%" height="100%">
                                    <m:Image src="{imageUrl}" width="auto" height="50px"
                                           decorative="false" alt="Product Image"
                                           densityAware="false" class="sapUiTinyMargin" />
                                </m:VBox>
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </smartTable:SmartTable>
        </m:VBox>
    </m:content>
    
    <m:buttons>
        <m:Button text="{i18n>add}" type="Emphasized" press="onSelectProducts" />
        <m:Button text="{i18n>cancel}" press="onCancelSelectProducts" />
    </m:buttons>
</m:Dialog>

</core:FragmentDefinition>