                        <t:template>
                            <m:Text text="{path: 'budgetKT>m17', formatter: '.formatBudgetNumber'}"/>
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:TreeTable>
        </uxap:moreBlocks>
    </uxap:ObjectPageSubSection>
</core:FragmentDefinition>