<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:uxap="sap.uxap"
    xmlns:smartTable="sap.ui.comp.smarttable"
>
    <uxap:ObjectPageSubSection
        id="sapOrderItemsSubSection"
        title="{i18n>orderTab}"
    >
        <uxap:blocks>
            <m:VBox width="100%">
                <smartTable:SmartTable
                    id="sapOrderItemsSmartTable"
                    entitySet="OrderItems"
                    tableType="Table"
                    useVariantManagement="true"
                    useTablePersonalisation="true"
                    showRowCount="true"
                    persistencyKey="SAPOrderItemsTableKey"
                    enableAutoBinding="true"
                    class="sapUiResponsiveContentPadding"
                    enableAutoColumnWidth="true"
                    enableCopy="false"
                    enableExport="true"
                    editable="false"
                    beforeRebindTable="onBeforeRebindOrderTable" 
                    customizeConfig='{"textInEditModeSource": {"*": "ValueList"}}' 
                >
                    <t:Table
                        selectionMode="None"
                    />
                </smartTable:SmartTable>
            </m:VBox>
        </uxap:blocks>
    </uxap:ObjectPageSubSection>
</core:FragmentDefinition>