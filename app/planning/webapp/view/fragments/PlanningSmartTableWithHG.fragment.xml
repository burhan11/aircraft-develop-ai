<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:uxap="sap.uxap"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:rowmodes="sap.ui.table.rowmodes"
>
    <smartTable:SmartTable
        id="planningProductsSmartTable"
        entitySet="PlanningProducts"
        smartFilterId="planningProductsSmartFilterBar"
        tableType="Table"
        useVariantManagement="true"
        useTablePersonalisation="true"
        showRowCount="true"
        persistencyKey="PlanningProductsTableKey"
        enableAutoBinding="true"
        class="sapUiResponsiveContentPadding"
        enableAutoColumnWidth="true"
        enableCopy="false"
        enableExport="false"
        editTogglable="{= (${status_ID} === 'InProgress' || ${status_ID} === 'CreationFailed') &amp;&amp; !!${budgetData>/houseGroupBudgets} }"
        app:useSmartToggle="true"
        app:useSmartField="true"
        requestAtLeastFields="product/imageUrl,product/isUploaded,index,differingHouseGroups/houseGroup_ID,totalAmount,product_supplyType_SUPPLY_TYPE,product/supplier_ID"
        changeModelValue="onChangeModelValue"
        beforeRebindTable="onBeforeRebindPlanningTable"
        ignoredFields="index,productionPlant_SUPPLIER"
        customizeConfig='{"textInEditModeSource": {"*": "ValueList"}}' 
    >
        <smartTable:customToolbar>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />
                <m:Button
                    id="generateDefaultPWithHG"
                    text="{i18n>planning.generateDefault}"
                    type="Transparent"
                    press=".onGenerateDefaultAmounts"
                    enabled="{= (${status_ID} === 'InProgress')&amp;&amp; !!${budgetData>/houseGroupBudgets} }"
                />
                <m:Button
                    id="changeProductSelectionPWithHG"
                    text="{i18n>planning.changeProductSelection}"
                    type="Transparent"
                    press=".changeProductSelection"
                    enabled="{= (${status_ID} === 'InProgress' || ${status_ID} === 'CreationFailed')&amp;&amp; !!${budgetData>/houseGroupBudgets} }"
                />
                <m:Button
                    id="amountChange"
                    text="{i18n>planning.amountChange}"
                    type="Transparent"
                    press="openAmountChangeDialog"
                    enabled="false"
                />
                <m:Button
                    id="deletePlanningProducts"
                    text="{i18n>delete}"
                    type="Transparent"
                    press=".onDeleteSelectedProducts"
                    enabled="false"
                />
                <m:Button
                    id="showBudgetHG"
                    text=""
                    type="Transparent"
                    press=".onShowBudgetHG"
                    enabled="false"
                />
            </m:OverflowToolbar>
        </smartTable:customToolbar>

        <t:Table enableColumnFreeze="true">
            <t:rowMode>
                <rowmodes:Auto minRowCount="30"></rowmodes:Auto>
            </t:rowMode>
            <t:columns>
                <t:Column
                    id="imageUrl"
                    autoResizable="true"
                    resizable="true"
                    hAlign="Center"
                    minWidth="80px"
                >
                    <t:customData>
                        <core:CustomData
                            key="p13nData"
                            value="{'columnKey': 'product/imageUrl','columnIndex':'2'}"
                        />
                    </t:customData>
                    <t:label>
                        <m:Label text="{i18n>planning.imageUrl}" />
                    </t:label>
                    <t:template>
                        <m:VBox
                            justifyContent="Center"
                            alignItems="Center"
                            width="100%"
                            height="100%"
                        >
                            <m:Image
                                src="{product/imageUrl}"
                                width="auto"
                                height="50px"
                                decorative="false"
                                alt="Product Image"
                                densityAware="false"
                                class="sapUiTinyMargin"
                            />
                        </m:VBox>
                    </t:template>
                </t:Column>
                <t:Column
                    id="differingHouseGroups"
                    autoResizable="true"
                    resizable="true"
                    minWidth="180px"
                >
                    <t:customData>
                        <core:CustomData
                            key="p13nData"
                            value="{'columnKey': 'differingHouseGroups','columnIndex':'16'}"
                        />
                    </t:customData>
                    <t:label>
                        <m:Label text="{i18n>planning.differingHouseGroups}" />
                    </t:label>
                    <t:template>
                        <m:MultiComboBox
                            items="{ path:'/HouseGroups',
                                    templateShareable: false}"
                            selectedKeys="{
                path: 'differingHouseGroups',
                formatter: '.formatDifferingHouseGroups'
            }"
                            selectionFinish=".onHouseGroupSelectionChange"
                            editable="{= ${editState>/editable} === true }"
                            enabled="{= ${editState>/editable} === true &amp;&amp; !!${differingSizeKey} }"
                        >
                            <core:Item
                                key="{ID}"
                                text="{name}"
                            />
                        </m:MultiComboBox>
                    </t:template>
                </t:Column>
                <t:Column
                    id="houseGroupLabel"
                    autoResizable="true"
                    resizable="true"
                    hAlign="Center"
                    minWidth="80px"
                >
                    <t:customData>
                        <core:CustomData
                            key="p13nData"
                            value="{'columnKey': 'houseGroupLabel','columnIndex':'25'}"
                        />
                    </t:customData>
                    <t:label>
                        <m:Label text="Budget-Typ" />
                    </t:label>
                    <t:template>
                        <m:VBox
                            justifyContent="Center"
                            alignItems="Center"
                            width="100%"
                            height="100%"
                        >
                            <m:Text text="" />
                        </m:VBox>
                    </t:template>
                </t:Column>
                <t:Column
                    id="totalAmount"
                    autoResizable="true"
                    resizable="true"
                    hAlign="Center"
                    minWidth="80px"
                >
                    <t:customData>
                        <core:CustomData
                            key="p13nData"
                            value="{'columnKey': 'totalAmount','columnIndex':'26'}"
                        />
                    </t:customData>
                    <t:label>
                        <m:Label text="{i18n>budgetKT.total}" />
                    </t:label>
                    <t:template>
                        <m:VBox
                            width="100%"
                            height="100%"
                        >
                            <m:Text text="{totalAmount}"/>
                        </m:VBox>
                    </t:template>
                </t:Column>
                <!-- <t:Column
                    id="houseGroupOverallAmount"
                    autoResizable="true"
                    resizable="true"
                    hAlign="Center"
                    minWidth="80px"
                >
                    <t:customData>
                        <core:CustomData
                            key="p13nData"
                            value="{'columnKey': 'houseGroupOverallAmount','columnIndex':'34'}"
                        />
                    </t:customData>
                    <t:label>
                        <m:Label text="{i18n>budgetKT.total}" />
                    </t:label>
                    <t:template>
                        <m:VBox
                            justifyContent="Center"
                            alignItems="Center"
                            width="100%"
                            height="100%"
                        >
                            <m:Text text="" />
                        </m:VBox>
                    </t:template>
                </t:Column> -->
            </t:columns>
        </t:Table>
    </smartTable:SmartTable>
</core:FragmentDefinition>
