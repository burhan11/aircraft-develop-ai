<mvc:View controllerName="com.valantic.preorder.products.controller.Main"
    xmlns:f="sap.f"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:html="http://www.w3.org/1999/xhtml"
    height="100%">
    <f:DynamicPage headerExpanded="true" preserveHeaderStateOnScroll="true">
        <f:header>
            <f:DynamicPageHeader id="productDynamicPageHeader" pinnable="true">
                <core:Fragment
                    fragmentName="com.valantic.preorder.products.view.fragments.ArticleListFilter"
                    type="XML" />
            </f:DynamicPageHeader>

        </f:header>
        <f:content>
            <IconTabBar
                id="idArticleIconTabBar"
                class="sapUiResponsiveContentPadding"
                select="onArticleTabBarSelect"
                selectedKey="ArticleList"
                stretchContentHeight="true">
                <items>
                    <IconTabFilter text="{i18n>articleList}" key="ArticleList">
                        <core:Fragment
                            fragmentName="com.valantic.preorder.products.view.fragments.ArticleList"
                            type="XML" />
                    </IconTabFilter>
                    <IconTabFilter text="Dashboard" key="ArticleDash">
                        <core:Fragment
                            fragmentName="com.valantic.preorder.products.view.fragments.ArticleDashboard"
                            type="XML" />
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </f:content>
    </f:DynamicPage>
    <!-- use this to make the table occupy the available screen height -->
    <!-- <VBox fitContainer="true">
    </VBox> -->
</mvc:View>