<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog
        id="addPriceDialog"
        title="{i18n>massEdit.purchase.newTitle}">
        <content>
            <f:SimpleForm
                id="purchaseForm"
                editable="true"
                layout="ResponsiveGridLayout"
                binding="{viewModel>/productDetails/newPurchaseData}">
                <f:content>
                    <Label text="{i18n>massEdit.purchase.colValidFrom}" />
                    <DatePicker
                        required="true"
                        change="handleValidation"
                        value="{path: 'viewModel>validFrom', type: 'sap.ui.model.type.Date' , formatOptions: {UTC: true}}"
                        width="100%" />

                    <Label text="{i18n>massEdit.purchase.colValidTo}" />
                    <DatePicker
                        required="true"
                        change="handleValidation"
                        value="{path: 'viewModel>validTo', type: 'sap.ui.model.type.Date' , formatOptions: {UTC: true}}"
                        width="100%" />

                    <Label text="{i18n>massEdit.purchase.colCurrency}" />
                    <ComboBox
                        required="true"
                        change="handleValidation"
                        selectedKey="{viewModel>currency_ID}"
                        items="{/Currencies}"
                        width="100%">
                        <core:Item key="{ID}" text="{ID} ({name})" />
                    </ComboBox>

                    <Label text="{i18n>massEdit.purchase.vat}" />
                    <ComboBox
                        required="true"
                        change="handleValidation"
                        selectedKey="{viewModel>vat_ID}"
                        items="{/VATs}"
                        width="100%">
                        <core:Item key="{ID}" text="{name}" />
                    </ComboBox>

                    <Label text="{i18n>product.purchase.purchasePrice}" />
                    <Input
                        required="true"
                        change="handleValidation"
                        value="{viewModel>purchasePrice}"
                        type="Number"
                        width="100%" />
                    <Label text="{i18n>massEdit.purchase.colPurchaseFactor}" />
                    <Input
                        required="true"
                        change="handleValidation"
                        value="{viewModel>purchaseFactor}"
                        type="Number"
                        width="100%" />
                    <Label text="{i18n>massEdit.purchase.colPurchasePriceUSD}" />
                    <Input
                        value="{viewModel>purchasePriceUSD}"
                        type="Number"
                        width="100%" />
                    <Label text="{i18n>massEdit.purchase.colPurchasePriceNet}" />
                    <Input
                        value="{viewModel>purchasePriceEURNetto}"
                        type="Number"
                        width="100%" />
                    <Label text="{i18n>massEdit.purchase.colProductDiscount1}" />
                    <Input
                        value="{viewModel>productDiscount1}"
                        type="Number"
                        width="100%" />
                    <Label text="{i18n>massEdit.purchase.colProductDiscount2}" />
                    <Input
                        value="{viewModel>productDiscount2}"
                        type="Number"
                        width="100%" />

                    <Label text="{i18n>massEdit.purchase.colProductDiscount3}" />
                    <Input
                        value="{viewModel>productDiscount3}"
                        type="Number"
                        width="100%" />
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="{i18n>okay}" type="Emphasized"
                press=".onSavePurchase" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>