<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:plugins="sap.ui.table.plugins"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield"
>

    <Dialog id="uploadWizardDialog" title="{i18n>wizard.dialog.title}" contentWidth="80%"
        afterClose="onWizardCancel" class="wizardHeaderDisabled">
        <content>
            <Wizard
                id="uploadWizard"
                renderMode="Page"
                finishButtonText="Anlegen"
                showNextButton="false"
                complete="onWizardCompleted"
                stepActivate="onUploadWizardStepActivate"
            >

                <!-- ############### SCHRITT 1: Header-Daten ############### -->
                <WizardStep id="step1" title="{i18n>wizard.step1.title}" validated="false"
                    nextStep="step2">
                    <smartForm:SmartForm id="_IDGenSmartForm1"
                        title="{i18n>massEdit.basic.title}"
                        editTogglable="false"
                        validationMode="Async"
                        editable="true"
                        class="uploadWizardSmartForm">
                        <smartForm:layout>
                            <smartForm:ColumnLayout columnsM="1" columnsL="1" columnsXL="1" />
                        </smartForm:layout>
                        <smartForm:Group>
                            <smartForm:GroupElement label="{i18n>wizard.step1.consumerTopic}">
                                <smartField:SmartField id="selectKT" value="{consumerTopic_ID}" textInEditModeSource="ValueList" changeModelValue="onFilterChange"/>
                            </smartForm:GroupElement>
                        </smartForm:Group>
                        <smartForm:Group>
                            <smartForm:GroupElement label="{i18n>wizard.step1.brand}">
                                <smartField:SmartField id="selectMarke" value="{brand_ID}" textInEditModeSource="ValueList" changeModelValue="onFilterChange" />
                            </smartForm:GroupElement>
                        </smartForm:Group>
                        <smartForm:Group>
                            <smartForm:GroupElement label="{i18n>wizard.step1.supplier}">
                                <smartField:SmartField id="selectLieferant" value="{supplier_ID}" textInEditModeSource="ValueList" changeModelValue="onFilterChange"/>
                            </smartForm:GroupElement>
                        </smartForm:Group>
                        <smartForm:Group>
                            <smartForm:GroupElement label="{i18n>wizard.step1.orderDate}">
                              <Select id="selectSchreibtermin" items="{wizard>/FilteredWritingAppointments}" 
                                enabled="{= !!${wizard>/FilteredWritingAppointments} }" change="onFilterChange" forceSelection="false">
                                <core:Item 
                                    key="{wizard>ID}"
                                    text="{= ${wizard>name} + ' (' + ${
                                        path: 'wizard>date',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: {style: 'medium'}
                                    } + ')' }"/>
                            </Select>
                            </smartForm:GroupElement>
                        </smartForm:Group>
                    </smartForm:SmartForm>
                    <!-- GPOPT-1449 -->
                    <!-- <f:SimpleForm id="_IDGenSimpleForm1" editable="true"
                        layout="ResponsiveGridLayout">


                        <Label id="_IDGenLabel1" text="{i18n>wizard.step1.consumerTopic}"
