                        </Select>

                    </f:SimpleForm> -->
                </WizardStep>

                <!-- ############### SCHRITT 2: Artikelauswahl ############### -->
                <WizardStep id="step2" title="{i18n>wizard.step2.title}" nextStep="step3"
                >
                    <u:FileUploader
                        id="fileUploader"
                        name="myFileUpload"
                        uploadUrl="upload/"
                        tooltip="{i18n>wizard.step2.fileUploaderTooltip}"
                        fileType="xlsx,xls"
                        change="onFileChange"
                    />
                    <core:Fragment
                        fragmentName="com.valantic.preorder.products.view.fragments.Table"
                        type="XML"
                    ></core:Fragment>
                </WizardStep>

                <!-- ############### SCHRITT 3: Optionale Felder ############### -->
                <WizardStep id="step3" title="{i18n>wizard.step3.title}"
                    nextStep="step4">
                    <core:Fragment
                        fragmentName="com.valantic.preorder.products.view.fragments.MassEdit"
                        type="XML"
                    ></core:Fragment>
                </WizardStep>

                <!-- ############### SCHRITT 4: Überprüfung & Speichern ############### -->
                <WizardStep id="step4" title="{i18n>wizard.step4.title}" validated="true"
                >
                    <core:Fragment
                        fragmentName="com.valantic.preorder.products.view.fragments.Review"
                        type="XML"
                    ></core:Fragment>
                </WizardStep>

            </Wizard>
        </content>
        <footer>

            <Toolbar>
                <ToolbarSpacer></ToolbarSpacer>

                <!-- Back Button: Visible on step 2, 3 (not step 1, not step 4) -->
                <Button text="{i18n>wizard.backButton}"
                    press="onUploadBackStep"
                    class="sapUiSmallMarginEnd"
                    visible="{= ${wizard>/currentStep} !== 'step1' }" />
                    <!-- GPOPT-1448: Make backButton visible at step4
                    &amp;&amp; ${wizard>/currentStep} !== 'step4' -->

                <!-- Next Button: Visible on step 1, 2, 3 (not step 4) -->
                <Button text="{i18n>wizard.nextButton}"
                    press="onUploadNextStep"
                    type="Emphasized"
                    enabled="{wizard>/step1Validated}"
                    visible="{= ${wizard>/currentStep} !== 'step4' }"
                />

                <!-- Save Button: Visible only on step 4 -->
                <Button text="{i18n>wizard.saveButton}"
                    press="onWizardCompleted"
                    type="Emphasized"
                    visible="{= ${wizard>/currentStep} === 'step4' }"
                />

                <Button id="_IDGenButton1" text="{i18n>wizard.dialog.cancelButton}"
                    press="onWizardCancel" />
            </Toolbar>

        </footer>

    </Dialog>
</core:FragmentDefinition>