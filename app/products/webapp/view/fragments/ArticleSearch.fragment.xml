<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="searchDialog"
        title="{i18n>search}" contentHeight="auto" contentWidth="auto">
        <content>
            <HBox alignContent="Center" justifyContent="Center"
                class="sapUiResponsiveContentPadding">

                <Input
                    id="searchInput"
                    placeholder="{i18n>articleSearchInputPlaceholder}"
                />
            </HBox>


        </content>
        <beginButton>
            <Button icon="sap-icon://search"
                press=".onCheckExistence" type="Emphasized" text="Suche" />
        </beginButton>

        <endButton>
            <Button
                text="{i18n>cancel}"
                press=".onCloseSearchDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>