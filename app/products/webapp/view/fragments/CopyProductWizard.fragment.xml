<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form">

    <Dialog id="copyProductWizardDialog" title="{i18n>massEdit.copyProduct.title}"
        afterClose="onCancelCopyWizard"
        resizable="true" draggable="true" contentWidth="80%">

        <Wizard id="copyProductWizard" complete="onCopyWizardCompleted"
            stepActivate="onCopyWizardStepActivate" showNextButton="false" renderMode="Page"
            finishButtonText="{i18n>massEdit.copyProduct.finishButtonText}" class="wizardHeaderDisabled">

            <!-- Step 1: Choose Colors -->
            <WizardStep id="copyStep1" title="{i18n>massEdit.copyProduct.step1Title}"
                validated="true" icon="sap-icon://palette" nextStep="copyStep2">

                <VBox class="sapUiMediumMargin">
                    <Label text="{i18n>massEdit.copyProduct.availableColors}" />
                    <!-- <MultiComboBox 
                        items="{/EvaluationColors}"
                        selectedKeys="{copyWizard>/selectedEvaluationColors.id}"
                        placeholder="{i18n>massEdit.copyProduct.placeholder}"
                        selectionChange="onEvaluationColorSelectionChange">
                        <core:Item key="{ID}" text="{name}" />
                    </MultiComboBox> -->
                    <MultiInput 
                        id="idMultiInputCopy" 
                        placeholder="{i18n>massEdit.copyProduct.placeholder}" 
                        class="sapUiTinyMarginEnd"
                        showValueHelp="false"
                        tokenUpdate="onSupplierColorSelectionChange" /> 
                </VBox>
                <HBox width="100%" justifyContent="SpaceBetween">
    <ToolbarSpacer />
    <Button text="{i18n>wizard.nextButton}"
        press="onCopyNextStep"
        type="Emphasized"
        enabled="{copyWizard>/step1Validated}" />
</HBox>
            </WizardStep>

            <!-- Step 2: Choose Writing Appointments per Color -->
            <WizardStep id="copyStep2" title="{i18n>massEdit.copyProduct.step2Title}"
                validated="true" icon="sap-icon://calendar" nextStep="copyStep3">

                <VBox class="sapUiMediumMargin">
                    <Table id="writingAppointmentPerColorTable"
                        items="{copyWizard>/selectedSupplierColors}"
                        growing="false"
                        growingThreshold="20"
                        mode="None">

                        <columns>
                            <Column>
                                <Text text="{i18n>massEdit.copyProduct.color}" />
                            </Column>
                            <Column>
                                <Text text="{i18n>massEdit.copyProduct.writingAppointment}" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem>
                                <cells>
                                    <!-- Color Name -->
                                    <VBox>
                                        <Text text="{copyWizard>name}"
                                            class="sapUiMediumMarginBottom" />
                                    </VBox>

                                    <!-- Writing Appointment Selection -->
                                    <VBox>
                                        <MultiComboBox items="{copyWizard>/filteredWritingAppointments}"
                                            selectedKeys="{copyWizard>selectedSupplierColors.writingAppointments}"
                                            selectionChange="onWritingAppointmentChange"
                                            placeholder="{i18n>massEdit.copyProduct.writingAppointmentPlaceholder}">
                                            <core:Item key="{copyWizard>ID}" text="{copyWizard>name}" />
                                        </MultiComboBox>
                                    </VBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
                <HBox width="100%" justifyContent="SpaceBetween">
    <Button text="{i18n>wizard.backButton}"
        press="onCopyBackStep" />
    <Button text="{i18n>wizard.nextButton}"
        press="onCopyNextStep"
        type="Emphasized"/>
</HBox>
            </WizardStep>

            <!-- Step 3: Choose Sizes per Color -->
            <WizardStep id="copyStep3" title="{i18n>massEdit.copyProduct.step3Title}"
                validated="true" icon="sap-icon://measuring-point" nextStep="copyStep4">

                <VBox class="sapUiMediumMargin">
                    <Table id="sizesPerColorTable"
                        items="{copyWizard>/selectedSupplierColors}"
                        growing="false"
                        growingThreshold="20"
                        mode="None">

                        <columns>
                            <Column>
                                <Text text="{i18n>massEdit.copyProduct.color}" />
                            </Column>
                            <Column>
                                <Text text="{i18n>massEdit.copyProduct.writingAppointment}" />
                            </Column>
                            <Column>
                                <Text text="{i18n>massEdit.sizes.size}" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem>
                                <cells>
                                    <!-- Color Name -->
                                    <VBox>
                                        <Text text="{copyWizard>name}"
                                            class="sapUiMediumMarginBottom" />
                                    </VBox>
                                    
                                    <!-- Writing Appointments -->
                                    <VBox>
                                        <Text
                                            text="{
                                            parts: [
                                                {path: 'copyWizard>writingAppointments'}
                                            ],
                                            formatter: '.formatWritingAppointmentNames'
                                        }" />
                                    </VBox>

                                    <!-- Size1 Selection -->
                                    <VBox>
                            <Table
                                items="{copyWizard>sizeCombinations}"
                                selectionChange="onSizeCombinationSelectionChange"
                                growing="false">
                                <columns>
                                    <Column width="40%">
                                        <Text text="{i18n>massEdit.identification.size1}" />
                                    </Column>
                                    <Column width="40%">
                                        <Text text="{i18n>massEdit.identification.size2}" />
                                    </Column>
                                    <Column width="20%">
                                        <Text text="" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                        <Input
                            value="{copyWizard>size1Id}"
                            showValueHelp="true"
                            valueHelpRequest=".onGenericValueHelpRequest"
                            showSuggestion="true"
                            suggest=".onGenericSuggest"
                            suggestionItemSelected=".onGenericSuggestionItemSelected"
                        >
                            <customData>
                                <core:CustomData key="dialogTitle" value="{i18n>massEdit.identification.size1}" />
                                <core:CustomData key="entitySet" value="/Sizes" />
                                <core:CustomData key="titleKey" value="CODE" />
                                <core:CustomData key="descKey" value="DESCRIPTION" />
                                <core:CustomData key="sortBy" value="SRTPO" />
                            </customData>
                        </Input> 
                        <Input
                            value="{copyWizard>size2Id}"
                            showValueHelp="true"
                            valueHelpRequest=".onGenericValueHelpRequest"
                            showSuggestion="true"
                            suggest=".onGenericSuggest"
                            suggestionItemSelected=".onGenericSuggestionItemSelected"
                        >
                            <customData>
                                <core:CustomData key="dialogTitle" value="{i18n>massEdit.identification.size2}" />
                                <core:CustomData key="entitySet" value="/Sizes" />
                                <core:CustomData key="titleKey" value="CODE" />
                                <core:CustomData key="descKey" value="DESCRIPTION" />
                                <core:CustomData key="sortBy" value="SRTPO" />
                            </customData>
                        </Input> 
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                press="onDeleteSizeCombination"
                                                tooltip="{i18n>massEdit.copyProduct.deleteCombination}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                            <Button 
                                text="{i18n>massEdit.copyProduct.addCombination}" 
                                press="onAddSizeCombination"
                                icon="sap-icon://add"
                                class="sapUiTinyMarginTop" />
                        </VBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
<HBox width="100%" justifyContent="SpaceBetween">
    <Button text="{i18n>wizard.backButton}"
        press="onCopyBackStep" />
    <Button text="{i18n>wizard.nextButton}"
        press="onCopyNextStep"
        type="Emphasized" />
</HBox>
            </WizardStep>

            <!-- Step 4: Choose GTIN per Color/Size Combination -->
            <WizardStep id="copyStep4" title="{i18n>massEdit.copyProduct.gtinTitle}"
                validated="true" icon="sap-icon://bar-code">

                <VBox class="sapUiMediumMargin">
                    <!-- GTIN Table -->
                    <Table id="gtinTable"
                        items="{copyWizard>/colorSizeCombinations}"
                        growing="false"
                        growingThreshold="20"
                        mode="None">

                        <columns>
                            <Column>
                                <Text text="{i18n>massEdit.copyProduct.color}" />
                            </Column>
                            <Column>
                                <Text text="{i18n>massEdit.copyProduct.writingAppointment}" />
                            </Column>
                            <Column>
                                <Text text="{i18n>massEdit.identification.size1}" />
                            </Column>
                            <Column>
                                <Text text="{i18n>massEdit.identification.size2}" />
                            </Column>
                            <Column>
                                <Text text="{i18n>massEdit.copyProduct.gtinLabel}" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem>
                                <cells>
                                    <!-- Color Name -->
                                    <Text text="{copyWizard>colorName}" />
                                    
                                    <!-- Writing Appointments -->
                                    <VBox>
                                        <Text
                                            text="{
                                            parts: [
                                                {path: 'copyWizard>writingAppointments'}
                                            ],
                                            formatter: '.formatWritingAppointmentNames'
                                        }" />
                                    </VBox>

                                    <!-- Size1 Name -->
                                    <Text text="{copyWizard>size1Name}" />

                                    <!-- Size2 Name -->
                                    <Text text="{copyWizard>size2Name}" />

                                    <!-- GTIN Input -->
                                    <Input value="{copyWizard>gtin}"
                                        placeholder="{i18n>massEdit.copyProduct.gtinPlaceholder}"
                                        maxLength="14"
                                        change="onGtinChange"
                                        enabled="{= !!${copyWizard>size1Id} || !!${copyWizard>size2Id}}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
                <HBox width="100%" justifyContent="SpaceBetween">
    <Button text="{i18n>wizard.backButton}"
        press="onCopyBackStep" />
    <Button text="{i18n>wizard.saveButton}"
        type="Emphasized"
        press="onCopyWizardCompleted" />
</HBox>
            </WizardStep>
        </Wizard>

        <footer>
            <Toolbar>
                <ToolbarSpacer></ToolbarSpacer>
                <Button text="{i18n>wizard.dialog.cancelButton}"
                    press="onCancelCopyWizard" />
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>