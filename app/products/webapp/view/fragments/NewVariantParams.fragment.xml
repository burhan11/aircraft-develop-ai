<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield"
>
    <Dialog
        title="{i18n>new.variant}"
        contentWidth="4rem"
    >
        <content>
            <smartForm:SmartForm
                id="smartFormNewVariantParams"
                editable="true"
                validationMode="Async"
                editTogglable="false"
            >
                <smartForm:layout>
                    <smartForm:ColumnLayout
                        columnsM="2"
                        columnsL="3"
                        columnsXL="4"
                    />
                </smartForm:layout>

                <smartForm:Group>
                    <!-- Consumer Topic -->
                    <smartForm:GroupElement label="Konsumententhema">
                        <smartField:SmartField
                            value="{consumerTopic_ID}"
                            mandatory="true"
                            textInEditModeSource="ValueList"
                            importance="High"
                        />
                    </smartForm:GroupElement>

                    <!-- Brand -->
                    <smartForm:GroupElement label="Marke">
                        <smartField:SmartField
                            value="{brand_ID}"
                            mandatory="true"
                            textInEditModeSource="ValueList"
                            importance="High"
                        />
                    </smartForm:GroupElement>

                    <!-- Supplier -->
                    <smartForm:GroupElement label="Lieferant">
                        <smartField:SmartField
                            value="{supplier_ID}"
                            mandatory="true"
                            textInEditModeSource="ValueList"
                            importance="High"
                        />
                    </smartForm:GroupElement>

                    <!-- Product Number -->
                    <smartForm:GroupElement label="{i18n>massEdit.identification.supplierProductNumber}">
                        <smartField:SmartField 
                            value="{supplierProductNumber}" 
                            mandatory="true"
                            textInEditModeSource="ValueList"
                            importance="High"
                        />
                    </smartForm:GroupElement>

                    <!-- <smartForm:GroupElement label="{i18n>massEdit.identification.evaluationColor}">
                        <smartField:SmartField
                            value="{evaluationColor_ID}"
                            mandatory="true"
                            textInEditModeSource="ValueList"
                            importance="High"
                        />
                    </smartForm:GroupElement> -->

                    <smartForm:SemanticGroupElement label="{i18n>massEdit.identification.supplierColor}">
                        <smartField:SmartField 
                            mandatory="true"
                            value="{supplierColor}"
                            importance="High"/>
                    </smartForm:SemanticGroupElement>

                    <!-- Color -->
                    <!-- <smartForm:GroupElement label="Auswertefarbe">
                        <smartField:SmartField
                            value="{evaluationColor_ID}"
                            mandatory="true"
                            textInEditModeSource="ValueList"
                        />
                    </smartForm:GroupElement> -->

                    <!-- Size -->
                    <smartForm:GroupElement label="Größe 1">
                        <smartField:SmartField
                            value="{size_1_CODE}"
                            mandatory="true"
                            textInEditModeSource="ValueList"
                            importance="High"
                        />
                    </smartForm:GroupElement>

                    <!-- GTIN -->
                    <smartForm:GroupElement label="GTIN">
                        <smartField:SmartField value="{GTIN}" />
                    </smartForm:GroupElement>

                    <!-- Order Name -->
                    <!-- <smartForm:GroupElement
                        label="{i18n>wizard.step1.orderDate}"
                    >
                        <ComboBox
                            id="newAuftragsnameVariants"
                            required="false"
                            change=".newFilterChanged"
                            selectedKey="{viewModel>writingAppointment_ID}"
                            items="{new>/filteredWritingAppointments}"
                            width="100%"
                        >
                            <core:Item
                                key="{new>ID}"
                                text="{= ${new>name}
                                        + ' (' + ${
                                            path: 'new>date',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: {style: 'medium'}
                                    } + ')' }"
                            />
                        </ComboBox>
                    </smartForm:GroupElement> -->
                </smartForm:Group>
            </smartForm:SmartForm>
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button icon="sap-icon://accept"
                    text="{i18n>next}"
                    type="Emphasized"
                    press=".onVariantAccept"
                />
                <Button icon="sap-icon://cancel"
                    text="{i18n>cancel}"
                    press=".onVariantReject"
                />
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
