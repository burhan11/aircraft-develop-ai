<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield"
>
    <Dialog
        title="{i18n>new.option}"
        contentWidth="4rem"
    >
        <content>
            <smartForm:SmartForm
                id="smartFormNewOptionsParams"
                editTogglable="false"
                validationMode="Async"
                editable="true"
            >
                <smartForm:layout>
                    <smartForm:ColumnLayout
                        columnsM="2"
                        columnsL="3"
                        columnsXL="4"
                    />
                </smartForm:layout>
                <smartForm:Group>
                    <smartForm:GroupElement
                        label="{i18n>wizard.step1.consumerTopic}"
                    >
                        <smartField:SmartField
                            id="newKT"
                            textInEditModeSource="ValueList"
                            mandatory="true"
                            value="{consumerTopic_ID}"
                            importance="Medium"
                            change=".newFilterChanged"
                        />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement label="{i18n>wizard.step1.brand}">
                        <smartField:SmartField
                            id="newMarke"
                            textInEditModeSource="ValueList"
                            mandatory="true"
                            value="{brand_ID}"
                            importance="High"
                            change=".newFilterChanged"
                        />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement
                        label="{i18n>wizard.step1.supplier}"
                    >
                        <smartField:SmartField
                            id="newLieferant"
                            textInEditModeSource="ValueList"
                            mandatory="true"
                            value="{supplier_ID}"
                            importance="High"
                            change=".newFilterChanged"
                        />
                    </smartForm:GroupElement>
                    <smartForm:GroupElement
                        label="{i18n>massEdit.identification.supplierProductNumber}"
                    >
                        <smartField:SmartField
                            textInEditModeSource="ValueList"
                            mandatory="true"
                            value="{supplierProductNumber}"
                            importance="High"
                        />
                    </smartForm:GroupElement>
                    <!-- <smartForm:GroupElement label="{i18n>massEdit.identification.evaluationColor}">
                        <smartField:SmartField
                            textInEditModeSource="ValueList"
                            mandatory="true"
                            value="{evaluationColor_ID}"
                            importance="High"
                            change=".newFilterChanged"
                        />
                    </smartForm:GroupElement> -->
                    <smartForm:SemanticGroupElement label="{i18n>massEdit.identification.supplierColor}">
                        <smartField:SmartField 
                            mandatory="true"
                            value="{supplierColor}"
                            importance="High"/>
                    </smartForm:SemanticGroupElement>
                    <smartForm:GroupElement
                        label="{i18n>wizard.step1.orderDate}"
                    >
                        <ComboBox
                            required="false"
                            change=".newFilterChanged"
                            selectedKey="{viewModel>writingAppointment_ID}"
                            items="{new>/filteredWritingAppointments}"
                            width="100%"
                        >
                            <core:Item
                                key="{new>ID}"
                                text="{= ${new>name}
                                        + ' (' + ${
                                            path: 'new>date',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: {style: 'medium'}
                                    } + ')' }"
                            />
                        </ComboBox>
                    </smartForm:GroupElement>
                </smartForm:Group>
            </smartForm:SmartForm>
        </content>
        <footer>
            <Toolbar>
                <content>
                    <ToolbarSpacer />
                    <Button
                        icon="sap-icon://accept"
                        text="{i18n>next}"
                        type="Emphasized"
                        press=".newProdParamsAccept"
                        ariaHasPopup="Dialog"
                    />
                    <Button
                        icon="sap-icon://cancel"
                        text="{i18n>cancel}"
                        press=".newProdParamsReject"
                        ariaHasPopup="Dialog"
                    />
                </content>
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
