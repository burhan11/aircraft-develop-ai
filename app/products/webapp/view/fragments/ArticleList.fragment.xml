<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:t="sap.ui.table"
>
    <HBox
        id="dynamicFilterBar"
        class="sapUiTinyMarginBottom"
        wrap="Wrap"
        renderType="Bare"
    />
    <VBox
        id="fragmentContainer"
        visible="{massEditFragModel>/showFragment}"
    />
    <!-- <smartFilterBar:SmartFilterBar id="smartFilterBar"
                    entitySet="FlatAppointments" persistencyKey="SmartFilter_Explored">
                    <smartFilterBar:layoutData>
                        <FlexItemData shrinkFactor="0" />
                    </smartFilterBar:layoutData>
                </smartFilterBar:SmartFilterBar> -->

    <SegmentedButton
        selectedKey="article"
        selectionChange="onViewChange"
        class="sapUiSmallMarginBottom"
    >
        <items>
            <SegmentedButtonItem
                key="article"
                text="{i18n>list.article.title}"
            />
            <SegmentedButtonItem
                key="option"
                text="{i18n>list.option.title}"
            />
            <SegmentedButtonItem
                key="variant"
                text="{i18n>list.variant.title}"
            />
        </items>
    </SegmentedButton>
    <smartTable:SmartTable
        entitySet="FlatArticles"
        id="articleTable"
        smartFilterId="smartFilterBar"
        enableExport="true"
        beforeExport="onBeforeExport"
        useVariantManagement="true"
        useTablePersonalisation="true"
        header="{i18n>product.header}"
        uiStateChange="onUiStateChange"
        showRowCount="true"
        persistencyKey="SmartTableRefApp_Explored"
        requestAtLeastFields="ID,createdAt,topicComponent_ID"
        enableAutoBinding="true"
        class="sapUiResponsiveContentPadding"
        showFullScreenButton="true"
        initiallyVisibleFields="createdAt"
        beforeRebindTable="onBeforeRebindTable"
        initialise="onSmartTableInit"
        tableType="Table"
        editable="false"
        enableAutoColumnWidth="true"
        enableCopy="false"
        app:preserveDecimals="false"
        visible="{= ${oModelVisible>/showArticle} === true }"
    >
        <!-- layout data used to make the table growing but the filter bar fixed -->
        <smartTable:layoutData>
            <FlexItemData
                growFactor="1"
                baseSize="0%"
            />
        </smartTable:layoutData>

        <smartTable:customToolbar>
            <OverflowToolbar design="Transparent">
                <ToolbarSpacer />
                <Button
                    type="Transparent"
                    text="{i18n>new}"
                    press="onNewBtnPress"
                    icon="sap-icon://add"
                    enabled="true"
                />
                <Button
                    type="Transparent"
                    text="{i18n>copy}"
                    press="onCopyBtnPressTable"
                    icon="sap-icon://copy"
                    enabled="false"
                />
                <Button
                    type="Transparent"
                    text="{i18n>upload}"
                    press="onUploadBtnPress"
                    icon="sap-icon://upload"
                    enabled="false"
                />
                <Button
                    type="Transparent"
                    text="{i18n>search}"
                    press="onSearchBtnPress"
                    icon="sap-icon://search"
                />
            </OverflowToolbar>
        </smartTable:customToolbar>
        <t:Table
            id="lineItemsArticleTable"
            rowMode="Auto"
            enableColumnFreeze="true" 
            class="sapUiResponsiveContentPadding">
        </t:Table>
    </smartTable:SmartTable>

    <smartTable:SmartTable
        id="variantTable"
        entitySet="FlatProductSizes"
        visible="{= ${oModelVisible>/showVariant} === true }"
        enableAutoBinding="true"
        tableType="Table"
        header="{oModelVisible>/tableHeader}"
        class="sapUiResponsiveContentPadding"
        smartFilterId="smartFilterBar"
        enableExport="true"
        beforeExport="onBeforeExport"
        useVariantManagement="true"
        useTablePersonalisation="true"
        uiStateChange="onUiStateChange"
        showRowCount="true"
        persistencyKey="SmartTableRefVariant_Explored"
        requestAtLeastFields="ID,imageUrl,isUploaded,supplierColor,createdAt"
        showFullScreenButton="true"
        initiallyVisibleFields="createdAt"
        beforeRebindTable="onBeforeRebindTable"
        initialise=""
        editable="false"
        enableAutoColumnWidth="true"
        enableCopy="false"
        app:preserveDecimals="false"
    >
        <smartTable:layoutData>
            <FlexItemData
                growFactor="1"
                baseSize="0%"
            />
        </smartTable:layoutData>

        <smartTable:customToolbar>
            <OverflowToolbar design="Transparent">
                <ToolbarSpacer />
                <Button
                    type="Transparent"
                    text="{i18n>new}"
                    press="onNewBtnPressVariant"
                    icon="sap-icon://add"
                    enabled="true"
                />
                <Button
                    type="Transparent"
                    text="{i18n>copy}"
                    press="onCopyBtnPressTable"
                    icon="sap-icon://copy"
                    enabled="false"
                />
                <Button
                    type="Transparent"
                    text="{i18n>upload}"
                    press="onUploadBtnPress"
                    icon="sap-icon://upload"
                />
                <Button
                    type="Transparent"
                    text="{i18n>search}"
                    press="onSearchBtnPress"
                    icon="sap-icon://search"
                />
            </OverflowToolbar>
        </smartTable:customToolbar>
        <smartTable:customData>
            <core:CustomData
                key="p13nDialogSettings"
                value="{'columns':{'visible':true}}"
            />
        </smartTable:customData>
        <t:Table
            id="lineItemsTableFlatVar"
            rowMode="Auto"
            enableColumnFreeze="true" 
            class="sapUiResponsiveContentPadding"
        >
            <t:columns>
                <t:Column
                    id="imageUrlFlatVar"
                    autoResizable="true"
                    resizable="true"
                    hAlign="Center"
                    width="80px"
                >
                    <t:customData>
                        <core:CustomData
                            key="p13nData"
                            value="{'columnKey': 'imageUrl','columnIndex':'0'}"
                        />
                    </t:customData>
                    <t:label>
                        <Label text="{i18n>product.image}" />
                    </t:label>
                    <t:template>
                        <VBox
                            justifyContent="Center"
                            alignItems="Center"
                            width="100%"
                            height="100%"
                        >
                            <Image
                                src="{imageUrl}"
                                width="auto"
                                height="50px"
                                visible="{= ${imageUrl} ? true : false }"
                                decorative="false"
                                alt="Product Image"
                                densityAware="false"
                                class="sapUiTinyMargin"
                            />
                        </VBox>
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>
    </smartTable:SmartTable>
    <smartTable:SmartTable
        id= "LineItemsSmartTable" 
        entitySet="FlatAppointments"
        visible="{= ${oModelVisible>/showOption} === true }"
        enableAutoBinding="true"
        tableType="Table"
        header="{oModelVisible>/tableHeader}"
        class="sapUiResponsiveContentPadding"
        smartFilterId="smartFilterBar"
        enableExport="true"
        beforeExport="onBeforeExport"
        useVariantManagement="true"
        useTablePersonalisation="true"
        uiStateChange="onUiStateChange"
        showRowCount="true"
        persistencyKey="SmartTableRefOption_Explored"
        requestAtLeastFields="ID,imageUrl,isUploaded,supplierColor,createdAt"
        showFullScreenButton="true"
        initiallyVisibleFields=""
        beforeRebindTable="onBeforeRebindTable"
        initialise=""
        editable="false"
        enableAutoColumnWidth="true"
        enableCopy="false"
        app:preserveDecimals="false"
    >
        <smartTable:layoutData>
            <FlexItemData
                growFactor="1"
                baseSize="0%"
            />
        </smartTable:layoutData>

        <smartTable:customToolbar>
            <OverflowToolbar design="Transparent">
                <ToolbarSpacer />
                <Button
                    type="Transparent"
                    text="{i18n>new}"
                    press="onNewBtnPressOption"
                    icon="sap-icon://add"
                    enabled="true"
                />
                <Button
                    type="Transparent"
                    text="{i18n>copy}"
                    press="onCopyBtnPressTable"
                    icon="sap-icon://copy"
                    enabled="{cache>/copyButtonEnabled}"
                />
                <Button
                    type="Transparent"
                    text="{i18n>upload}"
                    press="onUploadBtnPress"
                    icon="sap-icon://upload"
                />
                <Button
                    type="Transparent"
                    text="{i18n>search}"
                    press="onSearchBtnPress"
                    icon="sap-icon://search"
                />
                <!-- <Button type="Transparent" text="{i18n>batchProcessing}"
                            press="onBatchBtnPress"
                            enabled="true" /> -->
            </OverflowToolbar>
        </smartTable:customToolbar>

        <smartTable:customData>
            <core:CustomData
                key="p13nDialogSettings"
                value="{'columns':{'visible':true}}"
            />
        </smartTable:customData>
        <!-- Add the inner table with custom columns -->
        <t:Table
            id="lineItemsTable"
            rowMode="Auto"
            enableColumnFreeze="true" 
            class="sapUiResponsiveContentPadding"
        >
            <t:columns>
                <t:Column
                    id="imageUrl"
                    autoResizable="true"
                    resizable="true"
                    hAlign="Center"
                    width="80px"
                >
                    <t:customData>
                        <core:CustomData
                            key="p13nData"
                            value="{'columnKey': 'imageUrl','columnIndex':'0'}"
                        />
                    </t:customData>
                    <t:label>
                        <Label text="{i18n>product.image}" />
                    </t:label>
                    <t:template>
                        <VBox
                            justifyContent="Center"
                            alignItems="Center"
                            width="100%"
                            height="100%"
                        >
                            <Image
                                src="{imageUrl}"
                                width="auto"
                                height="50px"
                                visible="{= ${imageUrl} ? true : false }"
                                decorative="false"
                                alt="Product Image"
                                densityAware="false"
                                class="sapUiTinyMargin"
                            />
                        </VBox>
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>
    </smartTable:SmartTable>
</core:FragmentDefinition>
