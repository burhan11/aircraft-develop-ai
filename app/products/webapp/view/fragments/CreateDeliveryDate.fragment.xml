<core:FragmentDefinition xmlns:f="sap.ui.layout.form"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="addDeliveryDateDialog"
        title="{i18n>massEdit.deliveryDate.title}">
        <f:SimpleForm 
            id="deliveryDateForm"
        >
        <f:content>
                <Label text="{i18n>massEdit.deliveryDate.label}" />
                <DatePicker
                    required="true"
                    change="handleValidation"
                    id="deliveryDatePicker"
                    width="100%"
                    placeholder="{i18n>massEdit.deliveryDate.placeholder}"
                    displayFormat="long"
                    value="{path: 'viewModel>/productDetails/selectedDeliveryDate', type: 'sap.ui.model.type.Date', formatOptions: {UTC: true}}"
                     />
        </f:content>
        </f:SimpleForm>
        <beginButton>
            <Button text="{i18n>okay}" type="Emphasized"
                press=".onSaveDeliveryDate" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onDialogCancel" />
        </endButton>
        
    </Dialog>
</core:FragmentDefinition>