<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog
        id="addWritingAppointmentDialog"
        title="{i18n>massEdit.writingAppointment.newTitle}">
        <content>
            <f:SimpleForm
                id="writingAppointmentForm"
                editable="true"
                layout="ResponsiveGridLayout">
                <f:content>
                    <Label text="{i18n>wizard.step1.orderDate}" />
                    <ComboBox id="writingAppointmentComboBox"
                        required="true"
                        change="handleValidation"
                        items="{/WritingAppointments}"
                        width="100%">
                        <core:Item key="{ID}" text="{name}" />
                    </ComboBox>


                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="{i18n>okay}" type="Emphasized" press=".onSaveWritingAppointment" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>