<core:FragmentDefinition
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:smartchart="sap.ui.comp.smartchart"
    xmlns:mdc="sap.ui.mdc"
    xmlns:mdcc="sap.ui.mdc.chart"
    xmlns:variants="sap.ui.fl.variants"
    xmlns:data="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:sl="sap.ui.comp.navpopover">

    <m:Page showHeader="false">
        <m:VBox fitContainer="true">
            <smartchart:SmartChart id="smartChartArticleStatus"
                entitySet="ProductStatusSummary"
                enableAutoBinding="true"
                useVariantManagement="true"
                persistencyKey="PKeyChartExample92"
                useChartPersonalisation="true"
                header="{i18n>product.header}"
                showFullScreenButton="true"
                selectionMode="Multi"
                showChartTooltip="true"
                showDrillBreadcrumbs="false"
                showDetailsButton="false"
                showDrillButtons="false"
                showSemanticNavigationButton="false"
                height="100%"
                data:dateFormatSettings='\{"pattern":"y MMMM d"\}'
                uiStateChange="onUiStateChange">
                <!-- <smartchart:toolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <OverflowToolbarButton icon="sap-icon://activate"
                            tooltip="Sort by name in ascending order via UI state"
                            press="applyUIState"
                            type="Transparent" />
                    </OverflowToolbar>
                </smartchart:toolbar>
                <smartchart:semanticObjectController>
                    <sl:SemanticObjectController
                        navigationTargetsObtainedCallback=".navigationTargetsObtained"
                        replaceSmartLinkNavigationTargetsObtained="true" navigate="onNavigate" />
                </smartchart:semanticObjectController> -->
            </smartchart:SmartChart>
        </m:VBox>
    </m:Page>
</core:FragmentDefinition>