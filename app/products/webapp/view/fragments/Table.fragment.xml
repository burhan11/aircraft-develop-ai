<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:sap.ui.fl="sap.ui.fl"
    xmlns:vm="sap.ui.fl.variants"
    xmlns:columnmenu="sap.m.table.columnmenu"
    xmlns:mdc="sap.ui.mdc"
    xmlns:mdct="sap.ui.mdc.table"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
    <VBox id="_IDGenVBox">


        <t:Table
            id="persoTable"
            rows="{wizard>/UploadedArticles}"
            selectionMode="MultiToggle"
            ariaLabelledBy="title"
            rowSelectionChange="onUploadArticleTableChange"
            sort="onSort"
            columnResize="onColumnResize"
            columnMove="onColumnMove"
            filter="onFilter"
        >
            <t:extension>
                <Toolbar>
                    <Title
                        text="Artikel ({= ${wizard>/UploadedArticles}.length})"></Title>
                    <vm:VariantManagement id="p13nVm" for="persoTable" />

                    <ToolbarSpacer />
                    <Button
                        icon="sap-icon://action-settings"
                        tooltip="{i18n>tableSettingsTooltip}"
                        press="onPersonalizationPress"
                    />
                    <Button
                        id="delete"
                        text="{i18n>wizard.step2.deleteButton}"
                        enabled="false"
                        press="onDeleteArticles"
                        type="Reject"
                    />
                </Toolbar>
            </t:extension>
            <t:dependents>
                <columnmenu:Menu id="menu" showTableSettingsButton="true"
                    tableSettingsPressed="onPersonalizationPress">
                </columnmenu:Menu>
            </t:dependents>
            <t:rowSettingsTemplate>
                <t:RowSettings
                    highlight="{= ${wizard>existsIn} === 'SAP' ? 'Success' : ${wizard>existsIn} === 'PRICAT' ?
            'Success' : 'None'}"
                    highlightText="{
                            parts: [
                                {path: 'i18n>wizard.step2.status.alreadyExists'}, 
                                {path: 'wizard>existsIn'}
                            ], 
                            formatter: 'jQuery.sap.formatMessage'
                        }" />
            </t:rowSettingsTemplate>
            <t:columns>

                <t:Column width="6rem" app:p13nKey="repeatProduct_col">
                    <t:label>
                        <Text text="{i18n>wizard.step2.col.repeatProduct}" />
                    </t:label>
                    <t:template>
                        <ObjectStatus
                            text="{= ${wizard>existsIn} === 'SAP' ? 'Ja' : ${wizard>existsIn} === 'PRICAT' ? 'Ja' : 'Nein'}"
                            inverted="false"
                            state="{= ${wizard>existsIn} === 'SAP' ? 'Success' : ${wizard>existsIn} === 'PRICAT' ? 'Success' : 'None'}" />
                    </t:template>
                </t:Column>

                <t:Column width="6rem" app:p13nKey="image_col">
                    <t:label>
                        <Text text="{i18n>wizard.step2.col.image}" />
                    </t:label>
                    <t:template>
                        <Image src="{wizard>image}" width="50px" height="50px" />
                    </t:template>
                </t:Column>

                <!-- Supplier Article Number -->
                <t:Column width="12rem" app:p13nKey="supplierProductNumber_col"
                    sortProperty="supplierProductNumber" headerMenu="menu" resizable="true"
                    filterProperty="supplierProductNumber"
                    autoResizable="true">
