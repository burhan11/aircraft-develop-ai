<mvc:View
    controllerName="com.valantic.aircrafts.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:smartfield="sap.ui.comp.smartfield"
    xmlns:smartform="sap.ui.comp.smartform"
>
    <Page
        id="idDetaiPage"
        title="{i18n>title}"
    >
        <uxap:ObjectPageLayout id="idObjectPageLayout">
            <uxap:headerTitle>
                <uxap:ObjectPageHeader
                    objectTitle="{ID}"
                    isActionAreaAlwaysVisible="true"
                >
                    <uxap:actions>
                        <HBox justifyContent="End">
                            <Button
                                icon="sap-icon://edit"
                                class="sapUiSmallMarginEnd"
                                text="Edit"
                                type="Transparent"
                                press="onEditAeroplaneData"
                                enabled="{= ${detailViewModel>/detail/bInEditModel} !== true}"
                            />
                            <Button
                                icon="sap-icon://decline"
                                class="sapUiSmallMarginEnd"
                                text="Cancel"
                                type="Transparent"
                                press="onCancelAeroplaneData"
                                enabled="{detailViewModel>/detail/bInEditModel}"
                            />
                            <Button
                                icon="sap-icon://save"
                                class="sapUiSmallMarginEnd"
                                text="Save"
                                type="Transparent"
                                press="onSaveAeroplaneData"
                            />
                        </HBox>
                    </uxap:actions>
                </uxap:ObjectPageHeader>
            </uxap:headerTitle>
            <uxap:sections>
                <uxap:ObjectPageSection
                    id="idGeneral"
                    title="General"
                    titleUppercase="false"
                >
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <smartform:SmartForm
                                id="idGeneralData"
                                editTogglable="false"
                                editable="{detailViewModel>/detail/bInEditModel}"
                                validationMode="Async"
                            >
                                <smartform:layout>
                                    <smartform:ColumnLayout
                                        columnsM="2"
                                        columnsL="3"
                                        columnsXL="4"
                                    />
                                </smartform:layout>
                                <smartform:groups>
                                    <smartform:Group>
                                        <smartform:groupElements>
                                            <smartform:GroupElement>
                                                <smartfield:SmartField
                                                    textInEditModeSource="ValueList"
                                                    value="{model}"
                                                    importance="High"
                                                />
                                            </smartform:GroupElement>
                                            <smartform:GroupElement>
                                                <smartfield:SmartField
                                                    textInEditModeSource="ValueList"
                                                    value="{manufacturer}"
                                                    importance="High"
                                                />
                                            </smartform:GroupElement>
                                            <smartform:GroupElement>
                                                <smartfield:SmartField
                                                    textInEditModeSource="ValueList"
                                                    value="{category}"
                                                    importance="High"
                                                />
                                            </smartform:GroupElement>
                                        </smartform:groupElements>
                                    </smartform:Group>
                                </smartform:groups>
                            </smartform:SmartForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:ObjectPageSection>
                <uxap:ObjectPageSection
                    id="idPrice"
                    title="Other Information"
                    titleUppercase="false"
                >
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <smartform:SmartForm
                                id="idOtherInfo"
                                editTogglable="false"
                                editable="{detailViewModel>/detail/bInEditModel}"
                                validationMode="Async"
                            >
                                <smartform:layout>
                                    <smartform:ColumnLayout
                                        columnsM="2"
                                        columnsL="3"
                                        columnsXL="4"
                                    />
                                </smartform:layout>
                                <smartform:groups>
                                    <smartform:Group>
                                        <smartform:groupElements>
                                            <smartform:GroupElement>
                                                <smartfield:SmartField
                                                    textInEditModeSource="ValueList"
                                                    value="{capacity}"
                                                    importance="High"
                                                />
                                            </smartform:GroupElement>
                                            <smartform:GroupElement>
                                                <smartfield:SmartField
                                                    textInEditModeSource="ValueList"
                                                    value="{range}"
                                                    importance="High"
                                                />
                                            </smartform:GroupElement>
                                            <smartform:GroupElement>
                                                <smartfield:SmartField
                                                    textInEditModeSource="ValueList"
                                                    value="{confidence}"
                                                    importance="High"
                                                    editable="false"
                                                />
                                            </smartform:GroupElement>
                                        </smartform:groupElements>
                                    </smartform:Group>
                                </smartform:groups>
                            </smartform:SmartForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:ObjectPageSection>
            </uxap:sections>
        </uxap:ObjectPageLayout>
        <footer>
            <OverflowToolbar
                id="idChatFooter"
                height="90px"
            >
                <TextArea
                    id="idPromptInput"
                    class="sapUiMediumMarginBegin"
                    width="87%"
                    placeholder="Start typing..."
                    editable="{detailViewModel>/detail/bInEditModel}"
                />
                <Button
                    icon="sap-icon://ai"
                    type="Emphasized"
                    enabled="{detailViewModel>/detail/bInEditModel}"
                    class="sapUiSmallMarginTop"
                    press="onGenerate"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
