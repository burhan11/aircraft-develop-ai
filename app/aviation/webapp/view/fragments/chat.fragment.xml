<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Page
        title="AI Copilot"
        class="sapUiContentPadding"
    >
        <content>
            <ScrollContainer
                id="chatScrollContainer"
                height="85%"
                vertical="true"
            >
                <!-- Dynamic alignment: User on right, AI on left -->
                <List
                    items="{copilotModel>/messages}"
                    noDataText="Start conversation"
                >
                    <CustomListItem>
                        <VBox
                            class="sapUiSmallMarginBottom"
                            alignItems="{= ${copilotModel>isUser} ? 'End' : 'Start' }"
                        >
                            <!-- Custom styling classes applied via expressions -->
                            <VBox
                                width="80%"
                                class="{= ${copilotModel>isUser} ? 'sapUiContentPadding chatBubbleUser' : 'sapUiContentPadding chatBubbleAI' }"
                            >
                                <Text
                                    text="{copilotModel>sender}"
                                    class="sapUiTinyMarginBottom"
                                />
                                <Text text="{copilotModel>text}" />

                                <!-- Suggestion Interactive Bar -->
                                <VBox id="idSuggestionBox">
                                    <Panel
                                        width="100%"
                                        backgroundDesign="Solid"
                                    >
                                        <content>
                                            <VBox>
                                                <Text
                                                    text="Manufacturer suggestion is Boeing"
                                                />
                                                <HBox
                                                    visible="{copilotModel>hasSuggestions}"
                                                    class="sapUiTinyMarginTop"
                                                >
                                                    <Button
                                                        type="Accept"
                                                        icon="sap-icon://accept"
                                                        press=".onAcceptSuggestions"
                                                    />
                                                    <Button
                                                        class="sapUiTinyMarginBegin"
                                                        type="Reject"
                                                        icon="sap-icon://decline"
                                                        press=".onRejectSuggestions"
                                                    />
                                                </HBox>
                                            </VBox>
                                        </content>
                                    </Panel>
                                </VBox>
                            </VBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </ScrollContainer>
        </content>
        <footer>
            <OverflowToolbar height="60px">
                <TextArea
                    id="chatInputField"
                    placeholder="e.g. Create a Aircraft..."
                    width="90%"
                />
                <Button
                    class="sapUiSmallMarginTop"
                    icon="sap-icon://paper-plane"
                    type="Emphasized"
                    press=".onSendCopilotMessage"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</core:FragmentDefinition>
