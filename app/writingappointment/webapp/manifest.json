{
  "_version": "1.59.0",
  "sap.app": {
    "id": "com.valantic.preorder.writingappointment",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.14.0",
      "toolsId": "756cc71a-06a4-404e-9817-1b342f7254de"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/writing-appointment/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "WritingAppointments": {
          "semanticObject": "WritingAppointment",
          "action": "display",
          "icon": "sap-icon://retail-store-manager",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "_version": "1.2.0",
    "public": true,
    "service": "com.valantic.preorder"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.fe": {
    "app": {
      "hideDraft": {
        "enabled": true
      }
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "WritingAppointmentsList",
          "target": "WritingAppointmentsList"
        },
        {
          "pattern": "WritingAppointments({key}):?query:",
          "name": "WritingAppointmentsObjectPage",
          "target": "WritingAppointmentsObjectPage"
        }
      ],
      "targets": {
        "WritingAppointmentsList": {
          "type": "Component",
          "id": "WritingAppointmentsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/WritingAppointments",
              "enhanceI18n": "i18n/i18n.properties",
              "variantManagement": "Page",
              "navigation": {
                "WritingAppointments": {
                  "detail": {
                    "route": "WritingAppointmentsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "initialLoad": "Enabled",
              "liveMode": true
            }
          }
        },
        "WritingAppointmentsObjectPage": {
          "type": "Component",
          "id": "WritingAppointmentsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "enhanceI18n": "i18n/i18n.properties",
              "editableHeaderContent": false,
              "contextPath": "/WritingAppointments",
              "controlConfiguration": {
                "to_Products/@com.sap.vocabularies.UI.v1.LineItem#Products": {
                  "columns": {
                    "DataField::deliveryDates::date": {
                      "width": "100%"
                    },
                    "DataField::product::supplierProductNumber": {
                      "width": "100%"
                    }
                  },
                  "actions": {
                    "goToProductPage": {
                      "press": "com.valantic.preorder.writingappointment.ext.controller.GoToProductPage.GoToProductPage",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Artikelstammdaten-App"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
